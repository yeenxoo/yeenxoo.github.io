---
// Local-only preview of a password-protected post.
// The plaintext under src/content/private/ is gitignored, so on CI this
// collection is empty and no page is generated. `pnpm run encrypt` reads the
// built HTML of these pages and encrypts the part between the two markers.
import { getCollection, render } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Datetime from "@/components/Datetime.astro";
import config from "@/config";

export async function getStaticPaths() {
  const posts = await getCollection("private");
  return posts.map(post => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Layout title={`${post.data.title} | ${config.site.title}`}>
  <meta slot="head" name="robots" content="noindex, nofollow" />
  <Header />
  <main id="main-content" class="app-layout mt-8">
    <span data-private-start hidden></span>
    <h1 class="text-accent inline-block text-2xl font-bold sm:text-3xl">
      {post.data.title}
    </h1>
    <div class="my-2 flex items-center gap-2">
      <Datetime pubDatetime={post.data.pubDatetime} size="lg" />
    </div>
    <article
      id="article"
      class="app-prose max-w-app prose-pre:bg-(--shiki-light-bg) dark:prose-pre:bg-(--shiki-dark-bg) mt-8 w-full"
    >
      <Content />
    </article>
    <span data-private-end hidden></span>
  </main>
  <Footer />
</Layout>
